# Encryption key for API secrets stored in DB (AES-256)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a dev-only key is used (NOT safe for production).
# REQUIRED when NODE_ENV=production — the API and worker refuse to start without it.
ENCRYPTION_KEY=

# CORS — comma-separated list of allowed origins for browser requests to the API.
# Defaults to the local demo/admin dev servers (localhost:3000, localhost:3002) if unset.
# The API has no auth, so avoid "*" outside of local experimentation.
# CORS_ORIGIN=http://localhost:3000,http://localhost:3002
CORS_ORIGIN=

# Database
DATABASE_URL=postgres://openmerch:openmerch@localhost:5432/openmerch

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=openmerch
MINIO_SECRET_KEY=openmerch123

# Embroidery microservice
EMBROIDERY_SERVICE_URL=http://localhost:8000

# AI background removal (rembg microservice, services/rembg). Optional — leave unset to
# disable the editor's "AI" background-removal mode (the "Basic" threshold mode always
# works with no network call). Start the service with: docker compose --profile ai up
# REMBG_URL=http://localhost:7000
REMBG_URL=

# Unsplash API (free tier: 50 req/hour)
# Get your key at https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# AI Image Generation — Hugging Face Inference Providers (free "hf-inference" provider,
# model stabilityai/stable-diffusion-3-medium-diffusers). Get a free token (read-only,
# "Make calls to Inference Providers" permission) at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# WooCommerce order webhook signature (POST /api/v1/orders/webhook/woocommerce). Optional —
# leave unset to disable order ingestion from a WooCommerce storefront (the route responds
# 503). Must match the secret configured in the WooCommerce plugin's settings page
# (WooCommerce > OpenMerch in wp-admin). To test the local WordPress+WooCommerce dev
# environment (docker compose --profile woocommerce-dev), set this to
# openmerch-dev-secret-change-in-production — see scripts/wordpress-dev-setup.sh.
WOOCOMMERCE_WEBHOOK_SECRET=

# Abandoned-design cleanup (runs in the worker process — pnpm worker / docker compose
# --profile worker up). Permanently deletes draft/cart designs (and their production files
# in MinIO) that were never linked to a real order and haven't been edited in a while.
# "cart" designs get a longer grace period than "draft" ones. Set the *_ENABLED flag to
# "false" to disable the daily sweep entirely (the manual preview/run admin endpoints still
# work either way). See docs/WOOCOMMERCE_INTEGRATION.es.md.
ABANDONED_DESIGNS_CLEANUP_ENABLED=true
ABANDONED_DRAFT_RETENTION_DAYS=7
ABANDONED_CART_RETENTION_DAYS=30
