# Encryption key for API secrets stored in DB (AES-256)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a dev-only key is used (NOT safe for production).
# REQUIRED when NODE_ENV=production — the API and worker refuse to start without it.
ENCRYPTION_KEY=

# CORS — comma-separated list of allowed origins for browser requests to the API.
# Defaults to the local demo/admin dev servers (localhost:3000, localhost:3002) if unset.
# The API has no auth, so avoid "*" outside of local experimentation.
# CORS_ORIGIN=http://localhost:3000,http://localhost:3002
CORS_ORIGIN=

# Database
DATABASE_URL=postgres://openmerch:openmerch@localhost:5432/openmerch

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=openmerch
MINIO_SECRET_KEY=openmerch123

# Embroidery microservice
EMBROIDERY_SERVICE_URL=http://localhost:8000

# Unsplash API (free tier: 50 req/hour)
# Get your key at https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# AI Image Generation — Pollinations.ai
# Get your key at https://enter.pollinations.ai
VITE_POLLINATIONS_KEY=your_pollinations_key_here

# AI Image Generation (optional — alternative providers)
# OpenAI DALL-E: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# Stability AI: https://platform.stability.ai/account/keys
# VITE_STABILITY_API_KEY=your_stability_api_key_here
